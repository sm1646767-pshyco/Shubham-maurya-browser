{
  "name": "universal-browser",
  "version": "3.1.0",
  "description": "Universal Browser — Ad-free, fast, private browser by Shubham Maurya",
  "main": "main.js",
  "author": "Shubham Maurya",
  "license": "MIT",
  "homepage": "https://github.com/sm1646767-pshyco/Shubham-maurya-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/sm1646767-pshyco/Shubham-maurya-browser.git"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . 2>&1",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shubhammaurya.browser",
    "productName": "Universal Browser",
    "copyright": "Copyright © 2026 Shubham Maurya",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal Browser"
    }
  }
}