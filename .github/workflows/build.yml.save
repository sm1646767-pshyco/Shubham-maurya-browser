name: Build Browser

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

jobs:
  build-win:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'
      
      - name: Install dependencies
        run: npm install --no-audit --no-fund --prefer-offline
      
      - name: Build Windows
        run: npm run build -- --win
      
      - uses: actions/upload-artifact@v4
        with:
          name: windows-
