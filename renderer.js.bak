// ═══════════════════════════════════════════════════════════════
//   UNIVERSAL BROWSER — renderer.js
//   Author: Shubham Maurya
//   Version: 6.0.0
// ═══════════════════════════════════════════════════════════════
document.title = 'Universal Browser';

// ═══════════════════════════════════════════════════════════════
//   STATE
// ═══════════════════════════════════════════════════════════════
var tabs = [];
var activeTabId = null;
var tabCounter = 0;
var bookmarks = JSON.parse(localStorage.getItem('bookmarks') || '[]');
var history = JSON.parse(localStorage.getItem('history') || '[]');
var passwords = JSON.parse(localStorage.getItem('passwords') || '[]');
var settings = JSON.parse(localStorage.getItem('settings') || JSON.stringify({
  theme: 'dark',
  searchEngine: 'google',
  accentColor: '#89b4fa'
}));
var zoomLevel = 0;
var currentPanelTitle = '';
var activeDownloads = [];

// ═══════════════════════════════════════════════════════════════
//   DOM HELPER
// ═══════════════════════════════════════════════════════════════
function $(id) { return document.getElementById(id); }

// ═══════════════════════════════════════════════════════════════
//   SAVE HELPERS
// ═══════════════════════════════════════════════════════════════
function saveBookmarks() { localStorage.setItem('bookmarks', JSON.stringify(bookmarks)); }
function saveHistory() { localStorage.setItem('history', JSON.stringify(history.slice(0, 500))); }
function savePasswords() { localStorage.setItem('passwords', JSON.stringify(passwords)); }
function saveSettings() { localStorage.setItem('settings', JSON.stringify(settings)); }

function addToHistory(title, url) {
  if (!url || url.startsWith('about:') || url.startsWith('file:')) return;
  history.unshift({ title: title || url, url: url, time: Date.now() });
  saveHistory();
}

// ═══════════════════════════════════════════════════════════════
//   UTILS
// ═══════════════════════════════════════════════════════════════
function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function formatBytes(bytes) {
  if (!bytes) return '0 B';
  var units = ['B', 'KB', 'MB', 'GB'];
  var i = 0;
  while (bytes >= 1024 && i < units.length - 1) { bytes /= 1024; i++; }
  return bytes.toFixed(1) + ' ' + units[i];
}

// ═══════════════════════════════════════════════════════════════
//   10 SEARCH ENGINES
// ═══════════════════════════════════════════════════════════════
var SEARCH_ENGINES = {
  google: {
    name: 'Google',
    icon: '🔍',
    url: 'https://www.google.com/search?q='
  },
  duckduckgo: {
    name: 'DuckDuckGo',
    icon: '🦆',
    url: 'https://duckduckgo.com/?q='
  },
  bing: {
    name: 'Bing',
    icon: '🔵',
    url: 'https://www.bing.com/search?q='
  },
  brave: {
    name: 'Brave',
    icon: '🦁',
    url: 'https://search.brave.com/search?q='
  },
  yandex: {
    name: 'Yandex',
    icon: '🌐',
    url: 'https://yandex.com/search/?text='
  },
  baidu: {
    name: 'Baidu',
    icon: '🐉',
    url: 'https://www.baidu.com/s?wd='
  },
  yahoo: {
    name: 'Yahoo',
    icon: '💜',
    url: 'https://search.yahoo.com/search?p='
  },
  ecosia: {
    name: 'Ecosia',
    icon: '🌱',
    url: 'https://www.ecosia.org/search?q='
  },
  startpage: {
    name: 'Startpage',
    icon: '🔒',
    url: 'https://www.startpage.com/sp/search?query='
  },
  perplexity: {
    name: 'Perplexity AI',
    icon: '🤖',
    url: 'https://www.perplexity.ai/search?q='
  }
};

function normalizeUrl(input) {
  input = (input || '').trim();
  if (!input) return null;
  if (/^https?:\/\//i.test(input)) return input;
  if (/^[\w-]+\.[\w.-]+/.test(input) && input.indexOf(' ') === -1) return 'https://' + input;

  var engine = SEARCH_ENGINES[settings.searchEngine] || SEARCH_ENGINES.google;
  return engine.url + encodeURIComponent(input);
}

function applyTheme(theme) {
  document.body.classList.toggle('light', theme === 'light');
}

// ═══════════════════════════════════════════════════════════════
//   TOAST
// ═══════════════════════════════════════════════════════════════
function showToast(message, type, duration) {
  type = type || 'info';
  duration = duration || 3000;
  var container = $('toastContainer');
  if (!container) return;
  var toast = document.createElement('div');
  toast.className = 'toast ' + type;
  var icons = { info: 'ℹ️', success: '✅', error: '❌', warning: '⚠️' };
  toast.innerHTML = '<span class="toast-icon">' + (icons[type] || 'ℹ️') + '</span>' +
    '<div class="toast-content">' + escapeHtml(message) + '</div>';
  container.appendChild(toast);
  setTimeout(function() {
    toast.classList.add('removing');
    setTimeout(function() { toast.remove(); }, 300);
  }, duration);
}

// ═══════════════════════════════════════════════════════════════
//   TAB CREATION
// ═══════════════════════════════════════════════════════════════
function createTab(url, activate, incognito) {
  url = url || null;
  activate = activate === undefined ? true : activate;
  incognito = incognito || false;

  var id = ++tabCounter;
  var partition = incognito ? ('temp:incog-' + id + '-' + Date.now()) : 'persist:browser';

  var tabsList = $('tabsList');
  if (!tabsList) return null;

  var tabEl = document.createElement('div');
  tabEl.className = 'tab' + (incognito ? ' incognito' : '');
  tabEl.dataset.id = id;
  tabEl.innerHTML = '<span class="tab-favicon">🌐</span>' +
    '<span class="tab-title">New Tab</span>' +
    '<button class="tab-close" title="Close">×</button>';

  tabEl.addEventListener('click', function(e) {
    if (e.target.classList.contains('tab-close')) closeTab(id);
    else switchTab(id);
  });
  tabsList.appendChild(tabEl);

  var wv = document.createElement('webview');
  wv.setAttribute('partition', partition);
  wv.setAttribute('allowpopups', 'false');
  wv.setAttribute('useragent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36');
  wv.style.display = 'none';
  wv.style.width = '100%';
  wv.style.height = '100%';

  var contentEl = $('content');
  if (contentEl) contentEl.appendChild(wv);

  var tab = {
    id: id,
    title: 'New Tab',
    url: '',
    webview: wv,
    el: tabEl,
    incognito: incognito
  };
  tabs.push(tab);

  // ═══ Webview events ═══
  wv.addEventListener('dom-ready', function() {
    if (window.browserAPI && wv.getWebContentsId) {
      try { window.browserAPI.notifyWebviewReady(wv.getWebContentsId()); } catch (e) {}
    }
  });

  wv.addEventListener('page-title-updated', function(e) {
    tab.title = e.title || 'Untitled';
    tabEl.querySelector('.tab-title').textContent = tab.title;
    if (activeTabId === id) document.title = tab.title + ' — Universal Browser';
  });

  wv.addEventListener('page-favicon-updated', function(e) {
    if (e.favicons && e.favicons.length) {
      var iconEl = tabEl.querySelector('.tab-favicon');
      if (iconEl) {
        iconEl.innerHTML = '<img src="' + e.favicons[0] + '" style="width:100%;height:100%;border-radius:4px;" onerror="this.parentElement.textContent=\'🌐\'">';
      }
    }
  });

  wv.addEventListener('did-navigate', function(e) {
    tab.url = e.url;
    if (activeTabId === id) {
      var urlInput = $('urlInput');
      if (urlInput) urlInput.value = e.url;
      var startPage = $('startPage');
      if (startPage) startPage.classList.add('hidden');
      updateNavButtons();
    }
    addToHistory(tab.title, e.url);
  });

  wv.addEventListener('did-navigate-in-page', function(e) {
    if (e.isMainFrame && activeTabId === id) {
      var urlInput = $('urlInput');
      if (urlInput) urlInput.value = e.url;
    }
  });

  wv.addEventListener('did-start-loading', function() {
    if (activeTabId === id) {
      var urlInput = $('urlInput');
      var reloadBtn = $('reloadBtn');
      if (urlInput) urlInput.classList.add('loading');
      if (reloadBtn) reloadBtn.classList.add('loading');
    }
  });

  wv.addEventListener('did-stop-loading', function() {
    if (activeTabId === id) {
      var urlInput = $('urlInput');
      var reloadBtn = $('reloadBtn');
      if (urlInput) urlInput.classList.remove('loading');
      if (reloadBtn) reloadBtn.classList.remove('loading');
    }
    updateNavButtons();
  });

  wv.addEventListener('new-window', function(e) {
    e.preventDefault();
    if (e.url) createTab(e.url, true);
  });

  if (url) {
    try { wv.src = url; } catch (e) { wv.loadURL(url); }
    tab.url = url;
    setTimeout(function() {
      var startPage = $('startPage');
      if (startPage) startPage.classList.add('hidden');
    }, 100);
  } else {
    setTimeout(function() {
      var startPage = $('startPage');
      if (startPage) startPage.classList.remove('hidden');
    }, 100);
  }

  if (activate) switchTab(id);
  return tab;
}

// ═══ SWITCH / CLOSE TAB ═══
function switchTab(id) {
  var tab = tabs.find(function(t) { return t.id === id; });
  if (!tab) return;
  activeTabId = id;

  tabs.forEach(function(t) {
    t.el.classList.toggle('active', t.id === id);
    t.webview.classList.toggle('active', t.id === id);
    t.webview.style.display = t.id === id ? 'flex' : 'none';
  });

  var url = '';
  try { url = tab.webview.getURL() || tab.url; } catch (e) { url = tab.url; }
  var urlInput = $('urlInput');
  if (urlInput) urlInput.value = url || '';

  var startPage = $('startPage');
  if (startPage) {
    if (!url) startPage.classList.remove('hidden');
    else startPage.classList.add('hidden');
  }

  updateNavButtons();
  applyZoom();
}

function closeTab(id) {
  var idx = tabs.findIndex(function(t) { return t.id === id; });
  if (idx === -1) return;
  var tab = tabs[idx];
  try { tab.webview.remove(); } catch (e) {}
  try { tab.el.remove(); } catch (e) {}
  tabs.splice(idx, 1);

  if (tabs.length === 0) {
    createTab(null, true);
    return;
  }
  if (activeTabId === id) {
    switchTab(tabs[Math.max(0, idx - 1)].id);
  }
}

// ═══ NAV ═══
function updateNavButtons() {
  var tab = tabs.find(function(t) { return t.id === activeTabId; });
  var backBtn = $('backBtn');
  var forwardBtn = $('forwardBtn');
  if (!tab || !backBtn || !forwardBtn) return;
  try {
    backBtn.disabled = !tab.webview.canGoBack();
    forwardBtn.disabled = !tab.webview.canGoForward();
  } catch (e) {}
}

// ═══ NAVIGATE ═══
function navigate(input) {
  var url = normalizeUrl(input);
  if (!url) return;
  var tab = tabs.find(function(t) { return t.id === activeTabId; });
  if (!tab) { tab = createTab(); }
  if (!tab) return;
  try { tab.webview.src = url; } catch (e) { tab.webview.loadURL(url); }
  tab.url = url;
  var startPage = $('startPage');
  if (startPage) startPage.classList.add('hidden');
}

// ═══ ZOOM ═══
function applyZoom() {
  var tab = tabs.find(function(t) { return t.id === activeTabId; });
  if (!tab) return;
  var factor = Math.pow(1.2, zoomLevel);
  try { tab.webview.setZoomFactor(factor); } catch (e) {}
}

// ═══════════════════════════════════════════════════════════════
//   SIDE PANEL
// ═══════════════════════════════════════════════════════════════
function openPanel(title) {
  console.log('[Panel] Opening:', title);
  var panel = $('panel');
  var panelTitle = $('panelTitle');
  if (!panel) { console.error('[Panel] Missing!'); return; }

  currentPanelTitle = title;
  if (panelTitle) panelTitle.textContent = title;
  panel.classList.add('open');
  renderPanelContent(title);
}

function closePanel() {
  var panel = $('panel');
  if (panel) panel.classList.remove('open');
  currentPanelTitle = '';
}

function renderPanelContent(title) {
  var body = $('panelBody');
  if (!body) return;
  body.innerHTML = '';

  // ═══ BOOKMARKS ═══
  if (title === 'Bookmarks') {
    if (!bookmarks || bookmarks.length === 0) {
      body.innerHTML = '<div class="panel-empty">No bookmarks yet.<br><br>Click ☆ in URL bar to save a bookmark.</div>';
      return;
    }
    bookmarks.forEach(function(bm, i) {
      var el = document.createElement('div');
      el.className = 'panel-item';
      el.innerHTML = '<div class="panel-item-favicon">⭐</div>' +
        '<div class="panel-item-info">' +
        '<div class="panel-item-title">' + escapeHtml(bm.title || bm.url) + '</div>' +
        '<div class="panel-item-url">' + escapeHtml(bm.url) + '</div>' +
        '</div>' +
        '<button class="panel-item-del">✕</button>';
      el.querySelector('.panel-item-info').addEventListener('click', function() {
        navigate(bm.url);
        closePanel();
      });
      el.querySelector('.panel-item-del').addEventListener('click', function(e) {
        e.stopPropagation();
        bookmarks.splice(i, 1);
        saveBookmarks();
        renderPanelContent('Bookmarks');
      });
      body.appendChild(el);
    });
  }

  // ═══ HISTORY ═══
  else if (title === 'History') {
    if (!history || history.length === 0) {
      body.innerHTML = '<div class="panel-empty">No history yet.<br><br>Start browsing to see history here.</div>';
      return;
    }
    var clearBtn = document.createElement('button');
    clearBtn.style.cssText = 'width:100%; margin-bottom:12px; padding:10px; background:#f38ba8; color:#11111b; border:none; border-radius:8px; cursor:pointer; font-weight:600; font-family:inherit;';
    clearBtn.textContent = '🗑️ Clear All History';
    clearBtn.addEventListener('click', function() {
      if (confirm('Clear all history?')) {
        history = [];
        saveHistory();
        renderPanelContent('History');
        showToast('History cleared', 'success');
      }
    });
    body.appendChild(clearBtn);

    history.slice(0, 100).forEach(function(h) {
      var el = document.createElement('div');
      el.className = 'panel-item';
      var time = new Date(h.time).toLocaleString();
      el.innerHTML = '<div class="panel-item-favicon">🕐</div>' +
        '<div class="panel-item-info">' +
        '<div class="panel-item-title">' + escapeHtml(h.title || h.url) + '</div>' +
        '<div class="panel-item-url">' + time + '</div>' +
        '</div>';
      el.addEventListener('click', function() {
        navigate(h.url);
        closePanel();
      });
      body.appendChild(el);
    });
  }

  // ═══ DOWNLOADS ═══
  else if (title === 'Downloads') {
    if (!activeDownloads || activeDownloads.length === 0) {
      body.innerHTML = '<div class="panel-empty">No downloads yet.<br><br>Files you download will appear here.</div>';
      return;
    }
    activeDownloads.forEach(function(dl) {
      var el = document.createElement('div');
      el.className = 'download-item';
      var pct = dl.totalBytes > 0 ? Math.round((dl.receivedBytes / dl.totalBytes) * 100) : 0;
      el.innerHTML = '<div style="padding:12px; background:#313244; border-radius:8px; margin-bottom:8px;">' +
        '<div style="font-weight:600; margin-bottom:4px;">' + escapeHtml(dl.filename) + '</div>' +
        '<div style="font-size:11px; color:#6c7086;">' + formatBytes(dl.receivedBytes) + ' / ' + formatBytes(dl.totalBytes) + '</div>' +
        '<div style="height:4px; background:#1e1e2e; border-radius:2px; margin-top:6px; overflow:hidden;">' +
        '<div style="height:100%; width:' + pct + '%; background:linear-gradient(90deg,#89b4fa,#cba6f7);"></div>' +
        '</div></div>';
      body.appendChild(el);
    });
  }

  // ═══ PASSWORDS ═══
  else if (title === 'Passwords') {
    var info = document.createElement('div');
    info.style.cssText = 'padding:12px; background:#313244; border-radius:8px; margin-bottom:12px; font-size:12px; color:#a6adc8; line-height:1.6;';
    info.textContent = '🔐 Passwords saved locally on your device. Never shared.';
    body.appendChild(info);

    var addBtn = document.createElement('button');
    addBtn.style.cssText = 'width:100%; padding:10px; background:linear-gradient(135deg,#89b4fa,#cba6f7); color:#11111b; border:none; border-radius:8px; cursor:pointer; font-weight:600; margin-bottom:12px; font-family:inherit;';
    addBtn.textContent = '➕ Add New Password';
    addBtn.addEventListener('click', function() {
      var domain = prompt('Website (e.g. google.com):');
      if (!domain) return;
      var username = prompt('Username / Email:');
      if (!username) return;
      var password = prompt('Password:');
      if (!password) return;
      passwords.push({ domain: domain, username: username, password: password, time: Date.now() });
      savePasswords();
      renderPanelContent('Passwords');
      showToast('Password saved', 'success');
    });
    body.appendChild(addBtn);

    if (passwords.length === 0) {
      var empty = document.createElement('div');
      empty.className = 'panel-empty';
      empty.textContent = 'No passwords saved yet.';
      body.appendChild(empty);
    } else {
      passwords.forEach(function(p, i) {
        var el = document.createElement('div');
        el.className = 'panel-item';
        el.innerHTML = '<div class="panel-item-favicon">🔐</div>' +
          '<div class="panel-item-info">' +
          '<div class="panel-item-title">' + escapeHtml(p.domain) + '</div>' +
          '<div class="panel-item-url">' + escapeHtml(p.username) + '</div>' +
          '</div>' +
          '<button class="panel-item-del">✕</button>';
        el.querySelector('.panel-item-info').addEventListener('click', function() {
          navigator.clipboard.writeText(p.password);
          showToast('Password copied', 'success');
        });
        el.querySelector('.panel-item-del').addEventListener('click', function(e) {
          e.stopPropagation();
          if (confirm('Delete password?')) {
            passwords.splice(i, 1);
            savePasswords();
            renderPanelContent('Passwords');
          }
        });
        body.appendChild(el);
      });
    }
  }

  // ═══ STATISTICS ═══
  else if (title === 'Statistics') {
    var statsGrid = document.createElement('div');
    statsGrid.style.cssText = 'display:grid; grid-template-columns:1fr 1fr; gap:12px;';

    function statCard(icon, value, label) {
      return '<div style="background:#313244; padding:16px; border-radius:12px; text-align:center;">' +
        '<div style="font-size:24px; margin-bottom:8px;">' + icon + '</div>' +
        '<div style="font-size:24px; font-weight:700; background:linear-gradient(90deg,#89b4fa,#cba6f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:4px;">' + value + '</div>' +
        '<div style="font-size:11px; color:#a6adc8; text-transform:uppercase; letter-spacing:0.5px;">' + label + '</div>' +
        '</div>';
    }

    if (window.browserAPI && window.browserAPI.getStats) {
      window.browserAPI.getStats().then(function(stats) {
        statsGrid.innerHTML = 
          statCard('🛡️', stats.blocked || 0, 'Ads Blocked') +
          statCard('⏱️', Math.round((stats.timeSaved || 0) / 60) + 'm', 'Time Saved') +
          statCard('📉', ((stats.dataSaved || 0) / 1024).toFixed(1) + 'KB', 'Data Saved') +
          statCard('📑', tabs.length, 'Open Tabs') +
          statCard('⭐', bookmarks.length, 'Bookmarks') +
          statCard('🕐', history.length, 'History');
        body.appendChild(statsGrid);
      }).catch(function() {
        statsGrid.innerHTML = 
          statCard('📑', tabs.length, 'Open Tabs') +
          statCard('⭐', bookmarks.length, 'Bookmarks') +
          statCard('🕐', history.length, 'History') +
          statCard('🔐', passwords.length, 'Passwords');
        body.appendChild(statsGrid);
      });
    } else {
      statsGrid.innerHTML = 
        statCard('📑', tabs.length, 'Open Tabs') +
        statCard('⭐', bookmarks.length, 'Bookmarks') +
        statCard('🕐', history.length, 'History') +
        statCard('🔐', passwords.length, 'Passwords');
      body.appendChild(statsGrid);
    }
  }

  // ═══ SETTINGS ═══
  else if (title === 'Settings') {
    var engineOptions = '';
    Object.keys(SEARCH_ENGINES).forEach(function(key) {
      var eng = SEARCH_ENGINES[key];
      engineOptions += '<option value="' + key + '"' + (settings.searchEngine === key ? ' selected' : '') + '>' + eng.icon + ' ' + eng.name + '</option>';
    });

    body.innerHTML = '<div style="padding:8px;">' +
      
      '<h3 style="font-size:12px; color:#6c7086; margin-bottom:12px; text-transform:uppercase; font-weight:700;">Appearance</h3>' +
      '<div style="display:flex; justify-content:space-between; align-items:center; padding:12px; background:#313244; border-radius:8px; margin-bottom:6px; font-size:13px;">' +
      '<span>Theme</span>' +
      '<select id="settingTheme" style="background:#1e1e2e; color:#cdd6f4; border:1px solid #45475a; border-radius:6px; padding:6px 10px; font-family:inherit; cursor:pointer;">' +
      '<option value="dark"' + (settings.theme === 'dark' ? ' selected' : '') + '>🌙 Dark</option>' +
      '<option value="light"' + (settings.theme === 'light' ? ' selected' : '') + '>☀️ Light</option>' +
      '</select></div>' +
      
      '<h3 style="font-size:12px; color:#6c7086; margin:20px 0 12px; text-transform:uppercase; font-weight:700;">Search Engine</h3>' +
      '<div style="display:flex; justify-content:space-between; align-items:center; padding:12px; background:#313244; border-radius:8px; margin-bottom:6px; font-size:13px; gap:12px;">' +
      '<span>Default</span>' +
      '<select id="settingEngine" style="background:#1e1e2e; color:#cdd6f4; border:1px solid #45475a; border-radius:6px; padding:6px 10px; font-family:inherit; cursor:pointer; max-width:180px;">' +
      engineOptions +
      '</select></div>' +
      
      '<div style="padding:10px 12px; background:#313244; border-radius:8px; font-size:11px; color:#6c7086; line-height:1.6;">' +
      '💡 Search bar me URL type karo — selected engine pe search hoga.<br>' +
      '🔗 Direct URL type karo (jaise <b style="color:#89b4fa;">google.com</b>) — seedha khulega.' +
      '</div>' +
      
      '<h3 style="font-size:12px; color:#6c7086; margin:20px 0 12px; text-transform:uppercase; font-weight:700;">About</h3>' +
      '<div style="background:linear-gradient(135deg,rgba(137,180,250,0.1),rgba(203,166,247,0.1)); border:1px solid rgba(137,180,250,0.3); border-radius:12px; padding:20px; text-align:center;">' +
      '<div style="width:64px; height:64px; background:linear-gradient(135deg,#89b4fa,#cba6f7); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:24px; font-weight:900; color:#11111b; margin:0 auto 12px;">UB</div>' +
      '<div style="font-size:18px; font-weight:700; background:linear-gradient(90deg,#89b4fa,#cba6f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:4px;">Universal Browser</div>' +
      '<div style="font-size:12px; color:#6c7086; margin-bottom:12px;">by Shubham Maurya</div>' +
      '<div style="font-size:11px; color:#a6adc8; padding:4px 10px; background:#313244; border-radius:20px; display:inline-block;">Version 6.0.0</div>' +
      '</div></div>';

    var themeSel = $('settingTheme');
    if (themeSel) themeSel.addEventListener('change', function(e) {
      settings.theme = e.target.value;
      applyTheme(settings.theme);
      saveSettings();
      showToast('Theme: ' + e.target.value, 'success');
    });

    var engineSel = $('settingEngine');
    if (engineSel) engineSel.addEventListener('change', function(e) {
      settings.searchEngine = e.target.value;
      saveSettings();
      var eng = SEARCH_ENGINES[e.target.value];
      showToast('Search: ' + (eng ? eng.icon + ' ' + eng.name : e.target.value), 'success');
    });
  }
}

// ═══════════════════════════════════════════════════════════════
//   INIT EVENTS
// ═══════════════════════════════════════════════════════════════
function initEvents() {
  console.log('[Init] Attaching events...');

  // ═══ New Tab ═══
  var newTabBtn = $('newTabBtn');
  if (newTabBtn) newTabBtn.addEventListener('click', function() { createTab(null, true); });

  // ═══ Nav buttons ═══
  var backBtn = $('backBtn');
  if (backBtn) backBtn.addEventListener('click', function() {
    var tab = tabs.find(function(t) { return t.id === activeTabId; });
    if (tab && tab.webview.canGoBack()) tab.webview.goBack();
  });
  var forwardBtn = $('forwardBtn');
  if (forwardBtn) forwardBtn.addEventListener('click', function() {
    var tab = tabs.find(function(t) { return t.id === activeTabId; });
    if (tab && tab.webview.canGoForward()) tab.webview.goForward();
  });
  var reloadBtn = $('reloadBtn');
  if (reloadBtn) reloadBtn.addEventListener('click', function() {
    var tab = tabs.find(function(t) { return t.id === activeTabId; });
    if (tab) tab.webview.reload();
  });
  var homeBtn = $('homeBtn');
  if (homeBtn) homeBtn.addEventListener('click', function() {
    var startPage = $('startPage');
    if (startPage) startPage.classList.remove('hidden');
    var urlInput = $('urlInput');
    if (urlInput) { urlInput.value = ''; urlInput.focus(); }
  });

  // ═══ URL ═══
  var urlInput = $('urlInput');
  if (urlInput) {
    urlInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); navigate(urlInput.value); }
    });
    urlInput.addEventListener('focus', function() { urlInput.select(); });
  }
  var goBtn = $('goBtn');
  if (goBtn) goBtn.addEventListener('click', function() { navigate(urlInput.value); });

  // ═══ Start page search ═══
  var startSearch = $('startSearch');
  if (startSearch) {
    startSearch.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') navigate(e.target.value);
    });
  }

  // ═══ Shortcuts ═══
  document.querySelectorAll('.shortcut').forEach(function(el) {
    el.addEventListener('click', function() {
      if (el.dataset.url) navigate(el.dataset.url);
    });
  });

  // ═══ PANEL BUTTONS ═══
  var panelButtons = {
    bookmarksBtn: 'Bookmarks',
    historyBtn: 'History',
    downloadsBtn: 'Downloads',
    passwordsBtn: 'Passwords',
    statsBtn: 'Statistics',
    settingsBtn: 'Settings'
  };

  Object.keys(panelButtons).forEach(function(btnId) {
    var btn = $(btnId);
    if (btn) {
      var newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('[Click]', btnId);
        openPanel(panelButtons[btnId]);
      });
      console.log('[Init] Attached:', btnId);
    }
  });

  // ═══ Panel close ═══
  var panelClose = $('panelClose');
  if (panelClose) {
    var newClose = panelClose.cloneNode(true);
    panelClose.parentNode.replaceChild(newClose, panelClose);
    newClose.addEventListener('click', closePanel);
  }

  // ═══ AI Panel ═══
  var aiBtn = $('aiBtn');
  if (aiBtn) {
    var newAiBtn = aiBtn.cloneNode(true);
    aiBtn.parentNode.replaceChild(newAiBtn, aiBtn);
    newAiBtn.addEventListener('click', function() {
      var aiPanel = $('aiPanel');
      if (aiPanel) aiPanel.classList.add('open');
      setTimeout(function() {
        var aiInput = $('aiInput');
        if (aiInput) aiInput.focus();
      }, 300);
    });
  }

  var aiPanelClose = $('aiPanelClose');
  if (aiPanelClose) {
    aiPanelClose.addEventListener('click', function() {
      var aiPanel = $('aiPanel');
      if (aiPanel) aiPanel.classList.remove('open');
    });
  }

  // ═══ Incognito ═══
  var incognitoBtn = $('incognitoBtn');
  if (incognitoBtn) incognitoBtn.addEventListener('click', function() {
    createTab('https://www.google.com', true, true);
    showToast('Incognito tab opened', 'info');
  });

  // ═══ Reading Mode ═══
  var readingBtn = $('readingBtn');
  if (readingBtn) readingBtn.addEventListener('click', async function() {
    var tab = tabs.find(function(t) { return t.id === activeTabId; });
    if (!tab || !window.browserAPI) return;
    try {
      var result = await window.browserAPI.extractArticle();
      if (!result.success || !result.data) {
        showToast('Could not extract article', 'error');
        return;
      }
      var d = result.data;
      var html = '<h1>' + escapeHtml(d.title) + '</h1>';
      d.blocks.forEach(function(b) {
        if (b.type === 'img') html += '<img src="' + escapeHtml(b.src) + '" style="max-width:100%;border-radius:8px;margin:16px 0;" />';
        else if (b.type === 'pre') html += '<pre style="background:#181825;padding:16px;border-radius:8px;overflow:auto;">' + escapeHtml(b.text) + '</pre>';
        else html += '<' + b.type + '>' + escapeHtml(b.text) + '</' + b.type + '>';
      });
      var overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed; inset:0; background:#1e1e2e; z-index:600; overflow-y:auto; padding:60px 20px; color:#cdd6f4;';
      overlay.innerHTML = '<button style="position:fixed; top:30px; right:30px; width:40px; height:40px; border-radius:50%; background:#313244; border:none; color:#cdd6f4; cursor:pointer; font-size:20px;" onclick="this.parentElement.remove()">✕</button>' +
        '<article style="max-width:720px; margin:0 auto; font-family:Georgia,serif; line-height:1.8; font-size:18px;">' + html + '</article>';
      document.body.appendChild(overlay);
    } catch (err) {
      showToast('Reading mode failed', 'error');
    }
  });

  // ═══ Screenshot ═══
  var screenshotBtn = $('screenshotBtn');
  if (screenshotBtn) screenshotBtn.addEventListener('click', async function() {
    var tab = tabs.find(function(t) { return t.id === activeTabId; });
    if (!tab || !window.browserAPI) return;
    try {
      var image = await tab.webview.capturePage();
      var result = await window.browserAPI.saveScreenshot(image.toDataURL());
      if (result.success) showToast('Screenshot saved', 'success');
      else showToast('Failed', 'error');
    } catch (err) { showToast('Screenshot failed', 'error'); }
  });

  // ═══ Shield ═══
  var shield = $('shield');
  if (shield) shield.addEventListener('click', async function() {
    if (window.browserAPI) {
      if (confirm('Reset ad-block counter?')) {
        var n = await window.browserAPI.resetBlockedCount();
        var blockedCountEl = $('blockedCount');
        if (blockedCountEl) blockedCountEl.textContent = n;
        showToast('Counter reset', 'success');
      }
    }
  });

  // ═══ Tab search ═══
  var tabSearch = $('tabSearch');
  if (tabSearch) {
    tabSearch.addEventListener('input', function(e) {
      var q = e.target.value.toLowerCase();
      document.querySelectorAll('.tab').forEach(function(el) {
        var title = el.querySelector('.tab-title').textContent.toLowerCase();
        el.style.display = title.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  }

  // ═══ Command Palette ═══
  var cmdBtn = $('cmdBtn');
  if (cmdBtn) cmdBtn.addEventListener('click', function() {
    showToast('Command palette coming soon', 'info');
  });

  // ═══ Ad blocker count ═══
  if (window.browserAPI) {
    window.browserAPI.onBlockedCount(function(n) {
      var blockedCountEl = $('blockedCount');
      if (blockedCountEl) blockedCountEl.textContent = n;
    });
    window.browserAPI.onOpenNewTab(function(url) { createTab(url, true); });
    setInterval(async function() {
      try {
        var n = await window.browserAPI.getBlockedCount();
        var blockedCountEl = $('blockedCount');
        if (blockedCountEl) blockedCountEl.textContent = n;
      } catch (e) {}
    }, 2000);
  }

  console.log('[Init] ✅ All events attached');
}

// ═══════════════════════════════════════════════════════════════
//   BOOT
// ═══════════════════════════════════════════════════════════════
window.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 Universal Browser v6.0 booting...');
  applyTheme(settings.theme);
  createTab(null, true);
  setTimeout(initEvents, 100);
  console.log('✅ Boot complete');
});